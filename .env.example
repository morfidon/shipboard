# Copy this file to .env and change the values if you need to.
DATABASE_URL=postgres://shipboard:shipboard@localhost:5432/shipboard

# Better Auth signs its cookies with this. Make your own: pnpm dlx auth@latest secret
BETTER_AUTH_SECRET=
# Where the app runs. Better Auth builds its links from it.
BETTER_AUTH_URL=http://localhost:3000

# Stripe, in a sandbox only. Keys go in .env.local (never committed):
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Files: the storage service from compose.yaml, with its made-up local keys.
# In production: your Cloudflare R2 (region auto) or AWS S3 settings.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=shipboard-attachments
S3_ACCESS_KEY_ID=shipboard
S3_SECRET_ACCESS_KEY=shipboard-storage
