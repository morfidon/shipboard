# Copy this file to .env and change the values if you need to.
DATABASE_URL=postgres://shipboard:shipboard@localhost:5432/shipboard

# Better Auth signs its cookies with this. Make your own: pnpm dlx auth@latest secret
BETTER_AUTH_SECRET=
# Where the app runs. Better Auth builds its links from it.
BETTER_AUTH_URL=http://localhost:3000

# Stripe, in a sandbox only. Keys go in .env.local (never committed):
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
